# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Legacy CocoaPods integration of the native Adapty SDK (instead of spm_dependency), taken from
# the AdaptySDK-iOS branch that ships the 4.x podspecs; the resolved commit is pinned in Podfile.lock.
# Set `$AdaptyUseCocoaPods = false` to go back to SPM.
$AdaptyUseCocoaPods = true
$AdaptyIOSSDKVersion = '4.2.0-SNAPSHOT' # must match s.version of the podspecs on that branch
adapty_ios_pods_source = { :git => 'https://github.com/adaptyteam/AdaptySDK-iOS.git', :branch => 'feature/cocoapods-4x' }

# Required for spm_dependency in react-native-adapty (RN 0.75+ SPM integration).
use_frameworks! :linkage => :dynamic

target 'AdaptyRnSdkExample' do
  if $AdaptyUseCocoaPods
    %w[AdaptyLogger AdaptyCSimdjson AdaptyCodable AdaptyUIBuilder Adapty AdaptyUI AdaptyPlugin].each do |name|
      pod name, adapty_ios_pods_source
    end
  end

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Adapty Kids Mode (COPPA / Kids Category): opt-in via `ADAPTY_KIDS_MODE=1 pod install`.
    # The helper sets the `KidsMode` SPM trait on the AdaptySDK-iOS package reference that
    # `spm_dependency` creates in the Pods project. It MUST run after react_native_post_install,
    # which wipes and recreates all package references on every pod install. No-op otherwise.
    if ENV['ADAPTY_KIDS_MODE'] == '1'
      require Pod::Executable.execute_command('node', ['-p',
        'require.resolve(
          "react-native-adapty/ios/adapty_kids_mode.rb",
          {paths: [process.argv[1]]},
        )', __dir__]).strip
      adapty_enable_kids_mode(installer)
    end
  end
end
