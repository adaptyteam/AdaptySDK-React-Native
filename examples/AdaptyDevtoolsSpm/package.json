{
  "name": "AdaptyDevtoolsSpm",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "sync-src": "rsync -a --delete --exclude .gitkeep ../AdaptyDevtools/src/ ./src/",
    "credentials": "node ../../scripts/credentials.js",
    "credentials-force": "node ../../scripts/credentials.js --force-bundle",
    "prestart": "yarn sync-src && yarn credentials",
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "update-sdk-full": "../../scripts/build_and_install_pack.zsh && yarn kids-mode:enable",
    "update-native-modules": "cd ios && npx react-native spm",
    "link-assets": "react-native-asset",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prettier:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "kids-mode:enable": "adapty-spm-kids-mode enable",
    "kids-mode:disable": "adapty-spm-kids-mode disable",
    "postinstall": "yarn sync-src && patch-package && (adapty-spm-kids-mode enable || echo \"kids-mode: CLI absent in the installed react-native-adapty — run yarn update-sdk-full\")"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-adapty": "latest"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "typescript": "^6.0.3",
    "react-native-asset": "^2.1.1",
    "prompt-sync": "^4.2.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
